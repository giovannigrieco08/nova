# Supabase Project Configuration
# ISTRUZIONI: Copia questo file in ".env" e compila con i tuoi valori reali dal Supabase Dashboard

# Project Information
SUPABASE_PROJECT_REF=your-project-reference-id
SUPABASE_URL=https://your-project-ref.supabase.co

# API Keys
# ANON KEY: Chiave pubblica - sicura da usare nel client Flutter
SUPABASE_ANON_KEY=your_anon_public_key_here

# SERVICE ROLE KEY: Chiave segreta - NON usare mai nel client, solo in script backend/admin
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# PERSONAL ACCESS TOKEN: Per configurazione progetto via Management API
SUPABASE_ACCESS_TOKEN=your_personal_access_token_here

# Auth Configuration (target values)
MAILER_OTP_EXP=900
REFRESH_TOKEN_EXPIRY=2592000
