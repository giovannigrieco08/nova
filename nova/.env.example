# Supabase Project Configuration
# IMPORTANTE: Copia questo file come .env e inserisci le tue credenziali
# Il file .env NON deve essere committato in Git

# Project Information
SUPABASE_PROJECT_REF=your_project_ref_here
SUPABASE_URL=https://your_project_ref_here.supabase.co

# API Keys
# ANON KEY: Chiave pubblica - sicura da usare nel client Flutter
SUPABASE_ANON_KEY=your_anon_key_here

# SERVICE ROLE KEY: Chiave segreta - NON usare mai nel client, solo in script backend/admin
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Management API Token (per configurazione progetto via API)
SUPABASE_ACCESS_TOKEN=your_access_token_here

# Auth Configuration (target values)
MAILER_OTP_EXP=900
REFRESH_TOKEN_EXPIRY=2592000

# GIPHY API Key (required for GIF picker)
# Get your free API key at https://developers.giphy.com/
GIPHY_API_KEY=your_giphy_api_key_here
