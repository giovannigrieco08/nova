<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Nova</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>nova</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Deep Link: Custom URL Schemes -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- novaapp:// - Magic Link Authentication -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.galileimoro.nova.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>novaapp</string>
			</array>
		</dict>
		<!-- nova:// - Event Sharing & Deep Links -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.galileimoro.nova.events</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nova</string>
			</array>
		</dict>
	</array>

	<!-- Profile Feature: Camera and Photo Library Access (002-profile-setup) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Nova richiede accesso alla libreria foto per impostare la tua foto profilo e condividere immagini negli eventi.</string>
	<key>NSCameraUsageDescription</key>
	<string>Nova richiede accesso alla fotocamera per scattare la tua foto profilo e condividere foto nella chat.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Nova richiede il permesso per salvare immagini nella tua libreria foto.</string>

	<!-- Chat Feature: Audio Recording -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Nova richiede accesso al microfono per registrare messaggi audio nella chat.</string>

	<!-- Events Feature: Location Access -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Nova richiede accesso alla posizione per mostrarti eventi nelle vicinanze e aiutarti a trovare luoghi degli eventi.</string>
</dict>
</plist>
